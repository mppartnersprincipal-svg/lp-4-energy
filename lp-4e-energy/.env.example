# Copie para .env.local (dev) e cadastre na Vercel (Settings → Environment Variables).
# Nunca versione o .env.local. Depois de criar/trocar variável na Vercel: REDEPLOY.

# ---------- Públicas (vão para o navegador) ----------

# URL final da LP, sem barra no fim (canonical, sitemap, Open Graph, Schema).
# Conferir qual host não redireciona (com ou sem www) antes de definir.
NEXT_PUBLIC_SITE_URL=https://4eenergy.com.br

# WhatsApp comercial da 4E: DDI + DDD + número, só dígitos (ex.: 5562999999999)
# PENDENTE: o briefing não trouxe o número. Enquanto vazio, a LP usa o placeholder 5500000000000.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Google Tag Manager (GA4, Google Ads e Meta Pixel são configurados DENTRO do GTM)
NEXT_PUBLIC_GTM_ID=
# Referência para o container do GTM (a LP não carrega estes direto)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---------- Secretas (só servidor: /api/*) ----------

# Banco do /dashboard (projeto Supabase compartilhado da M|P; tabelas energy4e_*)
SUPABASE_URL=https://khipnjfbxjgvmjvyxero.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # Supabase → Project Settings → API keys → service_role (secreta; nunca no front)

# Login do /dashboard
DASHBOARD_PASSWORD=                   # senha única do /dashboard (mín. 8 caracteres)
DASHBOARD_SECRET=                     # string aleatória longa (mín. 16) para assinar o token de login

# Google Ads (só leitura). Sem as 5 primeiras, a seção mostra "conexão pendente".
GOOGLE_ADS_CUSTOMER_ID=               # conta de anúncios da 4E Energy (10 dígitos), NÃO a da M|P nem a MCC
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=603-989-2603   # MCC pela qual a conta é acessada
GOOGLE_ADS_API_VERSION=               # opcional; padrão v25

# GA4 (só leitura, Data API). Sem as duas, a seção mostra "conexão pendente". Ver DASHBOARD.md → GA4.
GA4_PROPERTY_ID=                      # ID numérico da PROPRIEDADE (Administrador → Detalhes da propriedade). Não é o G-XXXX
GOOGLE_SERVICE_ACCOUNT_JSON=          # JSON da conta de serviço dashboard-ga4@ (Leitor na propriedade); secreto
